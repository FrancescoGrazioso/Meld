//
// Config.xcconfig
// Meld iOS App Scaffold Configuration
//

PRODUCT_NAME = Meld
PRODUCT_BUNDLE_IDENTIFIER = com.meld.app
CODE_SIGN_ENTITLEMENTS = Configuration/iosApp.entitlements
INFOPLIST_PREPROCESS = YES
INFOPLIST_PREFIX_HEADER = $(DERIVED_FILE_DIR)/MetrolistVersion.h
SWIFT_VERSION = 5.9
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SDKROOT = iphoneos
// The KMP dependency graph publishes arm64 simulator binaries only.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
TARGETED_DEVICE_FAMILY = 1,2
ENABLE_USER_SCRIPT_SANDBOXING = NO
