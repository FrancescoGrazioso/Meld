cask "meld" do
  arch arm: "arm64", intel: "x64"

  version "@VERSION@"
  sha256 arm:   "@MACOS_ARM64_SHA256@",
         intel: "@MACOS_X64_SHA256@"

  url "https://github.com/FrancescoGrazioso/Meld/releases/download/v#{version}/meld-desktop-macos-#{arch}-#{version}.dmg"
  name "Meld"
  desc "YouTube Music desktop client"
  homepage "https://github.com/FrancescoGrazioso/Meld"

  livecheck do
    url :url
    strategy :github_latest
  end

  app "Meld.app"
end
